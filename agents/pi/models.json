{
  "providers": {
    "orcarouter": {
      "baseUrl": "https://api.orcarouter.ai/v1",
      "api": "openai-completions",
      "apiKey": "$ORCA_KEY",
      "authHeader": true,
      "models": [
        {
          "id": "tencent/hy3",
          "name": "Tencent Hy3",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 200000,
          "maxTokens": 8192,
          "compat": {
            "supportsDeveloperRole": false,
            "supportsReasoningEffort": true,
            "maxTokensField": "max_tokens"
          }
        }
      ]
    }
  }
}
