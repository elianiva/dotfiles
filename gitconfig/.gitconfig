# vim: ft=toml

[user]
  name = elianiva
  email = dicha.arkana03@gmail.com
	signingkey = A9680245

[credential]
  helper = cache --timeout 86400

[core]
  compression = 9
  editor = nvim

[pull]
  rebase = false

[commit]
  sign = true

[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative

[init]
  defaultBranch = master

[gpg]
	program = gpg2
